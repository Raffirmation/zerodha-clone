# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/zerodha-clone

# Secret used to sign JWTs - use a long random string in real deployments
JWT_SECRET=replace_this_with_a_long_random_secret

# Access token lifetime
JWT_EXPIRES_IN=7d

# Port the auth server runs on
PORT=5000

# Comma separated list of origins allowed to call this API with credentials
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
